# Public identity of this fork: the name visitors, callers and installers see.
#
# Forking? Change these first (bootstrap will ask if they still say WolfBBS).
# Only public-facing text comes from here. Internals such as the WOLFBBS_*
# settings, the "wolfbbs" Docker project and volume, and the binary names keep
# the WolfBBS name on purpose, as provenance.
#
# The live board name can still be changed later in /admin/config; this file
# is the default for new installs, the installer, and anything with no admin
# setting yet.
BBS_NAME=ResoNET BBS
BBS_REPO=mooserini/resonet-bbs
UPSTREAM_NAME=WolfBBS
UPSTREAM_REPO=Awassee/wolfbbs
